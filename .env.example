# MediTrack Environment Configuration

# Django Core
SECRET_KEY=django-insecure-meditrack-change-me-in-production-super-secret-key-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Database Configuration (PostgreSQL by default; sqlite fallback for local dev if DB_ENGINE=sqlite3)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=meditrack_db
DB_USER=meditrack_user
DB_PASSWORD=meditrack_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Simple JWT Settings (in minutes / days)
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Django Environment Setting (dev / prod)
DJANGO_SETTINGS_MODULE=meditrack.settings.dev
